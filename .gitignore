# See http://help.github.com/ignore-files/ for more about ignoring files.

# Build
bin/
obj/

# Runtime-uploaded files (LocalDiskFileStorageService) - local/dev only, never committed
App_Data/

# Visual Studio
.vs/
*.user
*.suo

# Rider
.idea/

# VS Code
.vscode/

# Node
node_modules/

# Publish
publish/
dist/

# Logs
logs/
*.log

# Test
TestResults/
coverage/

# Local Postgres backups (task 139) - never commit real data dumps
database/backups/

# Environment
.env
.env.*

# OS
Thumbs.db
Desktop.ini
# macOS
.DS_Store

# Claude local settings
.claude/settings.local.json
.claude-auto-worker.log
dashboard/index.html
.task-completions/
.claude-task-attempts*
.claude-task-start*
.aider*
.claude-verify-errors
.csv-lock
.active-workers
.claude-timed-out-*
.claude-decomposed-*
.claude-rescue-done-*

# hermes task_worker runtime state
.hermes-worker.log
.hermes-worker-attempts.json
.hermes-worker-failures.jsonl
.hermes-worker-status.json
.hermes-worker-decompose-tried.json
.hermes-scheduled-run.log
tasks.csv.tmp
__pycache__/

# task_claim.py cross-session claims: local coordination, not project history
.task-claims/
.claude-verify-errors*
.autopilot-memory.json
.claude-project-facts
.claude-token-usage
