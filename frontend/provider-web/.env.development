# Partner API base URL
NEXT_PUBLIC_API_URL=http://localhost:5337

# Dev-only "Test login" button on the login page (docs/DEVOPS.md). Enabled
# per user request 2026-08-08, to stay on until told to disable. DEV_AUTH_KEY
# must match backend/provider-api/ProviderApi/appsettings.Development.json's
# DevAuth:Key - the backend independently refuses this path outside
# Development regardless of what this sends it.
NEXT_PUBLIC_ENABLE_DEV_AUTH=true
DEV_AUTH_KEY=dev-only-provider-auth-key-local-1234567890

# Firebase Cloud Messaging web push (task 307, src/lib/push.ts). Values are
# public web config, not secrets (Firebase's own docs say so). Server-side
# push delivery now uses the real FCM sender - see
# backend/shared/Infrastructure/Services/FirebasePushNotificationProvider.cs -
# once the corresponding service-account key path is set in provider-api's
# and consumer-api's user-secrets (never committed). Same Firebase project as
# frontend/customer-web/.env.local's, since both apps register device tokens
# against the one backend push pipeline.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyC5-2bWdowNra70MvEEm0J7L-NsB243Wm0
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=glavyx-532ce.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=glavyx-532ce
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=151837459926
NEXT_PUBLIC_FIREBASE_APP_ID=1:151837459926:web:db4b65c3c39ac2c47bd077
