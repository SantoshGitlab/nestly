# Partner API base URL
NEXT_PUBLIC_API_URL=http://localhost:5337

# Dev-only "Test login" button on the login page (docs/DEVOPS.md). Enabled
# per user request 2026-08-08, to stay on until told to disable. DEV_AUTH_KEY
# must match backend/provider-api/ProviderApi/appsettings.Development.json's
# DevAuth:Key - the backend independently refuses this path outside
# Development regardless of what this sends it.
NEXT_PUBLIC_ENABLE_DEV_AUTH=true
DEV_AUTH_KEY=dev-only-provider-auth-key-local-1234567890

# Firebase Cloud Messaging web push (task 307, src/lib/push.ts). All five are
# optional and all-or-nothing - unset (as here), provider-web skips push
# registration entirely rather than crashing, since this project has no real
# FCM credentials in any environment yet (see
# SandboxPushNotificationProvider's doc comment - server-side push delivery
# is a logging sandbox everywhere today). Values are public web config, not
# secrets. NEXT_PUBLIC_FIREBASE_VAPID_KEY is the "Web Push certificates" key
# from Firebase Console > Project Settings > Cloud Messaging.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=
