{
  "name": "nestly",
  "tasks_csv": "tasks.csv",
  "branch": "autopilot-work",
  "verify": [
    "dotnet build Nestly.sln"
  ],
  "env": {
    "DOTNET_ROOT": "~/.dotnet",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },
  "path_prepend": [
    "~/.dotnet",
    "~/.dotnet/tools"
  ],
  "max_attempts": 3,
  "task_timeout_sec": 900,
  "context_files": [
    "AGENTS.md"
  ]
}
